{
  "jupyter-lite-schema-version": 0,
  "jupyter-config-data": {
  "lite:settings": {
      "lite:faviconUrl": "./files/utils/favicon.svg"
    },
    "appName": "🌐SFPPylite 🍏⏩🍎",
    "appVersion": "1.8.1",
    "faviconUrl": "./files/utils/favicon.ico",
    "contentsStorageName": "SFPPyLite Storage",
    "settingsStorageName": "SFPPyLite Storage",
    "disabledExtensions": [
      "@jupyterlab/drawio-extension",
      "jupyterlab-kernel-spy",
      "jupyterlab-tour"
    ],
    "settingsOverrides": {
      "@jupyterlab/notebook-extension:panel": {
        "toolbar": [
          {
            "name": "download",
            "label": "Download🍏⏩🍎",
            "args": {},
            "command": "docmanager:download",
            "icon": "ui-components:download",
            "rank": 50
          }
        ]
      },
      "@jupyterlab/launcher-extension:launcher": {
        "items": [
          {
            "command": "notebook:open",
            "args": {
              "path": "demo.ipynb"
            },
            "category": "SFPPy",
            "label": "🚀 Start Here: Demo"
          },
          {
            "command": "notebook:open",
            "args": {
              "path": "notebooks/comply.ipynb"
            },
            "category": "SFPPy",
            "label": "✅ Compliance"
          },
          {
            "command": "notebook:open",
            "args": {
              "path": "notebooks/example1.ipynb"
            },
            "category": "SFPPy",
            "label": "🔬 Example 1"
          },
          {
            "command": "notebook:open",
            "args": {
              "path": "notebooks/example2.ipynb"
            },
            "category": "SFPPy",
            "label": "📦 Example 2"
          },
          {
            "command": "notebook:open",
            "args": {
              "path": "notebooks/example3.ipynb"
            },
            "category": "SFPPy",
            "label": "⛓ Example 3"
          },
          {
            "command": "notebook:open",
            "args": {
              "path": "notebooks/example4.ipynb"
            },
            "category": "SFPPy",
            "label": "🔧 Example 4"
          },
          {
            "command": "notebook:open",
            "args": {
              "path": "notebooks/gui.ipynb"
            },
            "category": "SFPPy",
            "label": "🖼 GUI"
          },
          {
            "command": "notebook:open",
            "args": {
              "path": "notebooks/index.ipynb"
            },
            "category": "SFPPy",
            "label": "🧭 Index"
          },
          {
            "command": "filebrowser:open-url",
            "args": {
              "url": "utils/reset.html"
            },
            "category": "SFPPy",
            "label": "♻️ Reset Storage"
          }
        ]
      }
    }
  },
  "pyodide": {
    "packages": [
      "numpy",
      "scipy",
      "pandas",
      "matplotlib",
      "ipywidgets",
      "nbformat",
      "openpyxl",
      "ipyevents",
      "ipympl",
      "ipycanvas",
      "ipyleaflet",
      "plotly",
      "bqplot"
    ]
  }
}
